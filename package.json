{
  "name": "airsoft-club-bot",
  "version": "2.0.0",
  "description": "Airsoft Club — Telegram Bot + Mini App",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "dev:server": "nodemon index.js",
    "dev:webapp": "npm --prefix webapp run dev",
    "dev:local": "concurrently -n server,webapp -c cyan,magenta \"npm:dev:server\" \"npm:dev:webapp\"",
    "build:webapp": "cd webapp && npm install && npm run build",
    "setup": "npm install && cd webapp && npm install && npm run build"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "grammy": "^1.21.1",
    "mysql2": "^3.9.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.2"
  }
}
