APP_ENV=staging
PORT=3001
WEBAPP_URL=https://airsoft-staging.tangle.care

# Токен staging-бота (окремий бот з @BotFather)
BOT_TOKEN=
# Username нового ПРОД-бота без @ — staging не стартує, якщо BOT_TOKEN належить йому
PROD_BOT_USERNAME=

# Тестовий канал (staging-бот має бути там адміном) або порожньо — тоді анонсів не буде
CHANNEL_ID=
# ID основного каналу — staging ніколи туди не пише
PROD_CHANNEL_ID=

# Необов'язково: staging-бот пише лише цим чатам (через кому), решта тільки логується
TEST_CHAT_IDS=

ADMIN_IDS=
ORGANIZER_IDS=
PAYMENT_CARD_NUMBER=0000000000000000

# Окрема база! Не використовуй прод-базу
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=airsoft_staging

LOG_LEVEL=debug
KEEP_WARM_ENABLED=false
