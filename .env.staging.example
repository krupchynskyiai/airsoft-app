APP_ENV=staging

# Окремий бот зі своїм токеном (створити через @BotFather).
# Staging не стартує, якщо токен належить PROD_BOT_USERNAME.
BOT_TOKEN=
PROD_BOT_USERNAME=banana_airsoft_app_bot

# Тестовий канал/група (staging-бот має бути там адміном) або залиш порожнім,
# щоб анонси не публікувались взагалі.
CHANNEL_ID=
# ID основного каналу — staging не стартує з ним і ніколи туди не пише.
PROD_CHANNEL_ID=

# Необов'язково: дозволити staging-боту писати лише цим чатам (через кому).
# Решта повідомлень логуються як "Blocked" і не відправляються.
TEST_CHAT_IDS=

ADMIN_IDS=
ORGANIZER_IDS=
WEBAPP_URL=https://<staging-domain>
PAYMENT_CARD_NUMBER=0000000000000000

# Окрема база! Не використовуй прод-базу для staging.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=airsoft_staging

LOG_LEVEL=debug
KEEP_WARM_ENABLED=false
